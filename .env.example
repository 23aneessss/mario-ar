# Run npm run setup:env to generate .env with unique local secrets.
APP_PORT=3000
# Keep 127.0.0.1 locally. Set 0.0.0.0 when an OpenScaler port-forward
# must reach the container through the VM's private network interface.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=mario
POSTGRES_DB=mario
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgres://mario:GENERATE_ME@127.0.0.1:5434/mario
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=mario-photos
S3_ACCESS_KEY=mario-storage
S3_SECRET_KEY=GENERATE_ME
# HTTPS public origin only, no trailing path. Leave blank for local capture only.
PUBLIC_BASE_URL=
PHOTO_RETENTION_DAYS=7
RATE_LIMIT_SECRET=GENERATE_ME
CLEANUP_SECRET=GENERATE_ME
# false for local/direct app; true only behind Caddy which overwrites forwarded headers.
TRUST_PROXY=false
# For docker compose --profile https (domain DNS must point to your server).
APP_DOMAIN=
ACME_EMAIL=
