{$APP_DOMAIN} {
  request_body {
    max_size 8MB
  }
  @internal path /api/cleanup
  respond @internal 404
  reverse_proxy app:3000 {
    header_up X-Forwarded-For {remote_host}
  }
  header Strict-Transport-Security "max-age=31536000"
}

# OpenScaler exposes the project at this legacy HTTP port. Keep that address
# working, but move browsers to the secure origin required by camera APIs.
http://{$APP_DOMAIN}:9264 {
  redir https://{$APP_DOMAIN}{uri} permanent
}
